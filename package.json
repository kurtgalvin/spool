{
  "name": "spool",
  "displayName": "Spool",
  "description": "Manage multiple Claude Code terminal sessions",
  "version": "0.0.1",
  "publisher": "kurtgalvin",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "spool.newSession",
        "title": "New Session",
        "category": "Spool"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.95.0",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
