{
  "name": "spool",
  "displayName": "Spool",
  "description": "Manage multiple Claude Code terminal sessions",
  "version": "0.0.2",
  "publisher": "kurtgalvin",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "spool.newSession",
        "title": "New Session",
        "category": "Spool",
        "icon": "$(add)"
      },
      {
        "command": "spool.focusSession",
        "title": "Focus Session",
        "category": "Spool"
      },
      {
        "command": "spool.renameSession",
        "title": "Rename…",
        "category": "Spool"
      },
      {
        "command": "spool.killSession",
        "title": "Kill",
        "category": "Spool",
        "icon": "$(trash)"
      },
      {
        "command": "spool.markIdle",
        "title": "Mark Idle",
        "category": "Spool"
      },
      {
        "command": "spool.resumeSession",
        "title": "Resume",
        "category": "Spool",
        "icon": "$(debug-start)"
      },
      {
        "command": "spool.branchSession",
        "title": "Branch Side Thread",
        "category": "Spool",
        "icon": "$(git-branch)"
      },
      {
        "command": "spool.restartBroker",
        "title": "Restart Broker",
        "category": "Spool"
      },
      {
        "command": "spool.queueComment",
        "title": "Queue",
        "category": "Spool"
      },
      {
        "command": "spool.queueDraft",
        "title": "Queue on Session…",
        "category": "Spool",
        "icon": "$(send)"
      },
      {
        "command": "spool.deleteComment",
        "title": "Delete Comment",
        "category": "Spool",
        "icon": "$(trash)"
      },
      {
        "command": "spool.commentOnSelection",
        "title": "Comment for Claude",
        "category": "Spool"
      },
      {
        "command": "spool.sendComments",
        "title": "Send Comments",
        "category": "Spool",
        "icon": "$(send)"
      },
      {
        "command": "spool.moreComment",
        "title": "More…",
        "category": "Spool"
      },
      {
        "command": "spool.replyComment",
        "title": "Reply",
        "category": "Spool"
      },
      {
        "command": "spool.replyCommentLater",
        "title": "Reply Later",
        "category": "Spool"
      },
      {
        "command": "spool.sendComment",
        "title": "Send",
        "category": "Spool"
      },
      {
        "command": "spool.resolveComment",
        "title": "Resolve",
        "category": "Spool",
        "icon": "$(check)"
      },
      {
        "command": "spool.reopenComment",
        "title": "Reopen",
        "category": "Spool",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "spool.openComment",
        "title": "Open Comment",
        "category": "Spool"
      },
      {
        "command": "spool.sendQueuedComment",
        "title": "Send",
        "category": "Spool",
        "icon": "$(send)"
      },
      {
        "command": "spool.nextReply",
        "title": "Next Reply",
        "category": "Spool"
      },
      {
        "command": "spool.resumeHistory",
        "title": "Resume in Spool",
        "category": "Spool",
        "icon": "$(debug-start)"
      },
      {
        "command": "spool.branchHistory",
        "title": "Branch into Spool",
        "category": "Spool",
        "icon": "$(git-branch)"
      },
      {
        "command": "spool.refreshHistory",
        "title": "Refresh",
        "category": "Spool",
        "icon": "$(refresh)"
      },
      {
        "command": "spool.removeFromList",
        "title": "Remove from List",
        "category": "Spool",
        "icon": "$(close)"
      },
      {
        "command": "spool.previousStep",
        "title": "Previous Step",
        "category": "Spool",
        "icon": "$(chevron-left)"
      },
      {
        "command": "spool.nextStep",
        "title": "Next Step",
        "category": "Spool",
        "icon": "$(chevron-right)"
      },
      {
        "command": "spool.startWalkthrough",
        "title": "Start Walkthrough",
        "category": "Spool",
        "icon": "$(play)"
      },
      {
        "command": "spool.leaveWalkthrough",
        "title": "Leave Walkthrough",
        "category": "Spool"
      },
      {
        "command": "spool.resolveWalkthrough",
        "title": "Resolve Walkthrough",
        "category": "Spool",
        "icon": "$(check)"
      },
      {
        "command": "spool.reopenWalkthrough",
        "title": "Reopen Walkthrough",
        "category": "Spool",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "spool.deleteWalkthrough",
        "title": "Delete Walkthrough",
        "category": "Spool",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spool",
          "title": "Spool",
          "icon": "resources/spool.svg"
        }
      ]
    },
    "views": {
      "spool": [
        {
          "id": "spool.sessions",
          "name": "Sessions"
        },
        {
          "id": "spool.history",
          "name": "History",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "spool.sessions",
        "contents": "No Claude sessions yet.\n[New Session](command:spool.newSession)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "spool.sendComments",
          "when": "view == spool.sessions && viewItem =~ /^session:(starting|working|needs-input|idle):.*comments$/",
          "group": "inline@0"
        },
        {
          "command": "spool.newSession",
          "when": "view == spool.sessions && viewItem == group",
          "group": "inline"
        },
        {
          "command": "spool.branchSession",
          "when": "view == spool.sessions && viewItem =~ /^session:[^:]+:conversation/",
          "group": "inline@0"
        },
        {
          "command": "spool.resumeSession",
          "when": "view == spool.sessions && viewItem =~ /^session:exited:conversation/",
          "group": "inline@1"
        },
        {
          "command": "spool.killSession",
          "when": "view == spool.sessions && viewItem =~ /^session:(starting|working|needs-input|idle)(:|$)/",
          "group": "inline"
        },
        {
          "command": "spool.renameSession",
          "when": "view == spool.sessions && viewItem =~ /^session:/",
          "group": "1_edit@1"
        },
        {
          "command": "spool.markIdle",
          "when": "view == spool.sessions && viewItem =~ /^session:(working|needs-input)(:|$)/",
          "group": "2_status@1"
        },
        {
          "command": "spool.killSession",
          "when": "view == spool.sessions && viewItem =~ /^session:(starting|working|needs-input|idle)(:|$)/",
          "group": "3_lifecycle@1"
        },
        {
          "command": "spool.resumeSession",
          "when": "view == spool.sessions && viewItem =~ /^session:exited:conversation/",
          "group": "3_lifecycle@0"
        },
        {
          "command": "spool.branchSession",
          "when": "view == spool.sessions && viewItem =~ /^session:[^:]+:conversation/",
          "group": "1_edit@2"
        },
        {
          "command": "spool.sendComments",
          "when": "view == spool.sessions && viewItem =~ /^session:(starting|working|needs-input|idle):.*comments$/",
          "group": "1_edit@0"
        },
        {
          "command": "spool.sendQueuedComment",
          "when": "view =~ /^spool\\.(sessions|history)$/ && viewItem == comment:queued",
          "group": "inline@1"
        },
        {
          "command": "spool.queueDraft",
          "when": "view =~ /^spool\\.(sessions|history)$/ && viewItem == comment:draft",
          "group": "inline@1"
        },
        {
          "command": "spool.resolveComment",
          "when": "view =~ /^spool\\.(sessions|history)$/ && viewItem =~ /^comment:(sent|read|replied)$/",
          "group": "inline@2"
        },
        {
          "command": "spool.reopenComment",
          "when": "view =~ /^spool\\.(sessions|history)$/ && viewItem == comment:resolved",
          "group": "inline@2"
        },
        {
          "command": "spool.deleteComment",
          "when": "view =~ /^spool\\.(sessions|history)$/ && viewItem =~ /^comment:/",
          "group": "inline@3"
        },
        {
          "command": "spool.branchHistory",
          "when": "view == spool.history && viewItem =~ /^conversation/",
          "group": "inline@0"
        },
        {
          "command": "spool.resumeHistory",
          "when": "view == spool.history && viewItem =~ /^conversation/",
          "group": "inline@1"
        },
        {
          "command": "spool.removeFromList",
          "when": "view == spool.history && viewItem =~ /^conversation/",
          "group": "inline@2"
        },
        {
          "command": "spool.resumeHistory",
          "when": "view == spool.history && viewItem =~ /^conversation/",
          "group": "1_history@0"
        },
        {
          "command": "spool.branchHistory",
          "when": "view == spool.history && viewItem =~ /^conversation/",
          "group": "1_history@1"
        },
        {
          "command": "spool.removeFromList",
          "when": "view == spool.history && viewItem =~ /^conversation/",
          "group": "3_lifecycle@0"
        },
        {
          "command": "spool.branchSession",
          "when": "view == spool.history && viewItem =~ /^exited:conversation/",
          "group": "inline@0"
        },
        {
          "command": "spool.resumeSession",
          "when": "view == spool.history && viewItem =~ /^exited:conversation/",
          "group": "inline@1"
        },
        {
          "command": "spool.removeFromList",
          "when": "view == spool.history && viewItem =~ /^exited/",
          "group": "inline@2"
        },
        {
          "command": "spool.resumeSession",
          "when": "view == spool.history && viewItem =~ /^exited:conversation/",
          "group": "1_history@0"
        },
        {
          "command": "spool.branchSession",
          "when": "view == spool.history && viewItem =~ /^exited:conversation/",
          "group": "1_history@1"
        },
        {
          "command": "spool.renameSession",
          "when": "view == spool.history && viewItem =~ /^exited/",
          "group": "2_edit@0"
        },
        {
          "command": "spool.removeFromList",
          "when": "view == spool.history && viewItem =~ /^exited/",
          "group": "3_lifecycle@0"
        },
        {
          "command": "spool.startWalkthrough",
          "when": "view =~ /^spool\\.(sessions|history)$/ && viewItem =~ /^walkthrough:/",
          "group": "inline@0"
        },
        {
          "command": "spool.resolveWalkthrough",
          "when": "view =~ /^spool\\.(sessions|history)$/ && viewItem == walkthrough:open",
          "group": "inline@1"
        },
        {
          "command": "spool.reopenWalkthrough",
          "when": "view =~ /^spool\\.(sessions|history)$/ && viewItem == walkthrough:resolved",
          "group": "inline@1"
        },
        {
          "command": "spool.deleteWalkthrough",
          "when": "view =~ /^spool\\.(sessions|history)$/ && viewItem =~ /^walkthrough:/",
          "group": "inline@2"
        },
        {
          "command": "spool.sendQueuedComment",
          "when": "view =~ /^spool\\.(sessions|history)$/ && viewItem =~ /^step:queued/",
          "group": "inline@1"
        },
        {
          "command": "spool.resolveComment",
          "when": "view =~ /^spool\\.(sessions|history)$/ && viewItem =~ /^step:(sent|read|replied):thread$/",
          "group": "inline@2"
        },
        {
          "command": "spool.reopenComment",
          "when": "view =~ /^spool\\.(sessions|history)$/ && viewItem =~ /^step:resolved:thread$/",
          "group": "inline@2"
        },
        {
          "command": "spool.deleteComment",
          "when": "view =~ /^spool\\.(sessions|history)$/ && viewItem =~ /^step:/",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "spool.focusSession",
          "when": "false"
        },
        {
          "command": "spool.renameSession",
          "when": "false"
        },
        {
          "command": "spool.killSession",
          "when": "false"
        },
        {
          "command": "spool.markIdle",
          "when": "false"
        },
        {
          "command": "spool.resumeSession",
          "when": "false"
        },
        {
          "command": "spool.branchSession",
          "when": "false"
        },
        {
          "command": "spool.queueComment",
          "when": "false"
        },
        {
          "command": "spool.queueDraft",
          "when": "false"
        },
        {
          "command": "spool.deleteComment",
          "when": "false"
        },
        {
          "command": "spool.sendComments",
          "when": "false"
        },
        {
          "command": "spool.moreComment",
          "when": "false"
        },
        {
          "command": "spool.replyComment",
          "when": "false"
        },
        {
          "command": "spool.replyCommentLater",
          "when": "false"
        },
        {
          "command": "spool.sendComment",
          "when": "false"
        },
        {
          "command": "spool.resolveComment",
          "when": "false"
        },
        {
          "command": "spool.reopenComment",
          "when": "false"
        },
        {
          "command": "spool.openComment",
          "when": "false"
        },
        {
          "command": "spool.sendQueuedComment",
          "when": "false"
        },
        {
          "command": "spool.resumeHistory",
          "when": "false"
        },
        {
          "command": "spool.branchHistory",
          "when": "false"
        },
        {
          "command": "spool.removeFromList",
          "when": "false"
        },
        {
          "command": "spool.startWalkthrough",
          "when": "false"
        },
        {
          "command": "spool.resolveWalkthrough",
          "when": "false"
        },
        {
          "command": "spool.reopenWalkthrough",
          "when": "false"
        },
        {
          "command": "spool.deleteWalkthrough",
          "when": "false"
        },
        {
          "command": "spool.previousStep",
          "when": "spool.inWalkthrough"
        },
        {
          "command": "spool.nextStep",
          "when": "spool.inWalkthrough"
        },
        {
          "command": "spool.leaveWalkthrough",
          "when": "spool.inWalkthrough"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "spool.sendComment",
          "when": "commentController == spool && commentThreadIsEmpty",
          "group": "inline@1"
        },
        {
          "command": "spool.queueComment",
          "when": "commentController == spool && commentThreadIsEmpty",
          "group": "inline@2"
        },
        {
          "command": "spool.moreComment",
          "when": "commentController == spool && commentThreadIsEmpty",
          "group": "inline@3"
        },
        {
          "command": "spool.replyComment",
          "when": "commentController == spool && !commentThreadIsEmpty",
          "group": "inline@1"
        },
        {
          "command": "spool.replyCommentLater",
          "when": "commentController == spool && !commentThreadIsEmpty",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "spool.previousStep",
          "group": "inline@0",
          "when": "commentController == spool && commentThread =~ /:step:(middle|last)$/"
        },
        {
          "command": "spool.nextStep",
          "group": "inline@0",
          "when": "commentController == spool && commentThread =~ /:step:(first|middle)$/"
        },
        {
          "command": "spool.queueDraft",
          "when": "commentController == spool && commentThread =~ /^(draft|queued)$/",
          "group": "inline@1"
        },
        {
          "command": "spool.resolveComment",
          "when": "commentController == spool && commentThread =~ /^(sent|read|replied)(:|$)/",
          "group": "inline@2"
        },
        {
          "command": "spool.reopenComment",
          "when": "commentController == spool && commentThread =~ /^resolved(:|$)/",
          "group": "inline@2"
        },
        {
          "command": "spool.deleteComment",
          "when": "commentController == spool && !commentThreadIsEmpty",
          "group": "inline@3"
        }
      ],
      "editor/context": [
        {
          "command": "spool.commentOnSelection",
          "when": "resourceScheme == file && editorHasSelection",
          "group": "9_cutcopypaste@9"
        }
      ],
      "view/title": [
        {
          "command": "spool.refreshHistory",
          "when": "view == spool.history",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "spool.nextReply",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "spool.previousStep",
        "key": "ctrl+alt+[",
        "when": "spool.inWalkthrough"
      },
      {
        "command": "spool.nextStep",
        "key": "ctrl+alt+]",
        "when": "spool.inWalkthrough"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-missing-repository -o spool.vsix",
    "install-local": "npm run package && code --install-extension spool.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
